GITHUB_TOKEN=
GAIN_ENVIRONMENT=development
GAIN_GITHUB_API_URL=https://api.github.com/graphql
GAIN_GITHUB_REPOS=owner/repo1,owner/repo2
GAIN_START_AT=2025-09-01T00:00:00Z
GAIN_END_AT=2026-09-01T00:00:00Z
GAIN_OUTPUT_DIR=./data
GAIN_RAW_DIR=./data/raw
GAIN_CANONICAL_DIR=./data/canonical
GAIN_METRICS_DIR=./data/metrics
GAIN_PAGE_SIZE=50
GAIN_MAX_RETRIES=4
GAIN_BASE_BACKOFF_SECONDS=1.0
GAIN_RETRY_MAX_BACKOFF_SECONDS=30.0
GAIN_INCLUDE_BOTS=false

# Requirements → Jira → SDD (Jira is optional; leave credentials empty unless synchronizing)
GAIN_REQUIREMENTS_DIR=./data/requirements
GAIN_SPECIFICATION_SEED_DIR=./data/specification-seeds
GAIN_REQUIREMENTS_LLM_PROVIDER=
GAIN_REQUIREMENTS_LLM_MODEL=
GAIN_REQUIREMENTS_PROMPT_TEMPLATE_VERSION=story-generation-v1
GAIN_JIRA_BASE_URL=
GAIN_JIRA_TOKEN=
GAIN_JIRA_PROJECT_KEY=
GAIN_JIRA_STORY_POINTS_FIELD_ID=
GAIN_JIRA_SPRINT_FIELD_ID=
GAIN_JIRA_DESCRIPTION_FORMAT=adf
GAIN_JIRA_TIMEOUT_SECONDS=30
GAIN_JIRA_MAX_RETRIES=3
